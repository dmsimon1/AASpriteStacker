{
  "name": "@aastack/core",
  "version": "0.1.0",
  "description": "Zero-dependency, mobile-friendly WebGL2 anti-aliased 6-DOF & 2.5D sprite-stacking rendering engine SDK.",
  "license": "MIT",
  "homepage": "https://aasprite.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmsimon1/AASpriteStacker.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/dmsimon1/AASpriteStacker/issues",
  "keywords": ["sprite-stacking", "anti-aliasing", "webgl2", "voxel", "pixel-art", "2.5d", "6-dof", "game-engine", "magicavoxel"],
  "engines": { "node": ">=18.0.0" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./terrain": {
      "types": "./dist/terrain-shader.d.ts",
      "import": "./dist/terrain-shader.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "files": ["dist", "README.md"]
}
